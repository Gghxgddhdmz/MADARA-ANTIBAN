-- 🔄 حذف الأنيميشنات من جميع اللاعبين
for _, v in pairs(Players:GetPlayers()) do
	if v.Character then
		for _, anim in pairs(v.Character:GetDescendants()) do
			if anim:IsA("Animation") then
				anim:Destroy()
			end
		end
	end
end

-- 🖼️ إزالة القوام (Decal و Texture)
for _, v in pairs(workspace:GetDescendants()) do
	if v:IsA("Decal") or v:IsA("Texture") then
		v:Destroy()
	end
end

-- 🛡️ حماية من الطرد والباند والريموتات المشبوهة
spawn(function()
	local char = player.Character or player.CharacterAdded:Wait()

	-- إخفاء الاسم
	local h = char:FindFirstChild("Humanoid")
	if h then h.NameDisplayDistance = 0 end

	-- تعطيل الطرد بسبب عدم الحركة
	for _, v in pairs(getconnections(player.Idled)) do
		v:Disable()
	end

	-- تعطيل kick / Ban / Shutdown
	for _, v in pairs(getgc(true)) do
		if typeof(v) == "function" and islclosure(v) then
			local info = debug.getinfo(v)
			if info.name == "kick" or info.name == "Ban" or info.name == "Shutdown" then
				hookfunction(v, function() return end)
			end
		end
	end

	-- تعطيل الريموتات المشبوهة
	for _, obj in pairs(game:GetDescendants()) do
		if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
			local name = obj.Name:lower()
			if name:find("ban") or name:find("report") or name:find("cheat") then
				obj:Destroy()
			end
		end
	end

	-- منع destroy أو kick للـ LocalPlayer أو CoreGui
	local mt = getrawmetatable(game)
	setreadonly(mt, false)
	local old = mt.__namecall

	mt.__namecall = newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if (method == "Kick" or method == "Destroy") and (self == player or tostring(self):lower():find("coregui")) then
			return nil
		end
		return old(self, ...)
	end)
end)

print("✅ تم تفعيل النظام الكامل: حماية + تحسين أداء + منع طرد + Xray + إزالة قوام + حذف أنيميشنات + إخفاء الاسم")
