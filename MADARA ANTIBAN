-- 🔧 سكربت شامل: حماية + AntiAFK + Xray + حذف الأنيميشنات + تقليل حرارة + إزالة قوام + تعطيل مياه

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local VirtualUser = game:GetService("VirtualUser")
local Terrain = workspace:FindFirstChildOfClass("Terrain")

-- 📉 تقليل الإضاءة والجرافيكس
Lighting.GlobalShadows = false
Lighting.Brightness = 1
Lighting.FogEnd = 100000
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)

-- 🌊 تعطيل فيزياء المياه الثقيلة
if Terrain then
	Terrain.WaterWaveSize = 0
	Terrain.WaterWaveSpeed = 0
	Terrain.WaterReflectance = 0
	Terrain.WaterTransparency = 1
end

-- 🧼 حذف المؤثرات الثقيلة
for _, obj in pairs(workspace:GetDescendants()) do
	if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") then
		obj.Enabled = false
	end
end

-- 👁️ Xray (جعل الجدران شبه شفافة)
for _, part in pairs(workspace:GetDescendants()) do
	if part:IsA("BasePart") and part.Transparency < 0.95 then
		pcall(function()
			part.LocalTransparencyModifier = 0.7
		end)
	end
end

-- ⚙️ تحديد FPS (اختياري)
pcall(function()
	setfpscap(30)
end)

-- 💤 Anti-AFK
player.Idled:Connect(function()
	VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
	task.wait(1)
	VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
end)

